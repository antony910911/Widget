# LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=你的_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=你的_channel_access_token

# 伺服器埠號
PORT=3000

# 管理介面密碼（帳號固定為 admin）。留空 = 不設密碼（只建議在本機使用）
ADMIN_PASSWORD=

# 檔案存放資料夾與資料庫位置
STORAGE_DIR=./storage
DATA_DIR=./data

# 存檔後是否在群組回覆一句「已收到」（true/false）
REPLY_ON_SAVE=false
